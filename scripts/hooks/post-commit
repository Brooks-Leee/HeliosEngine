#!/bin/bash
COMMIT_COUNT=$(git rev-list --count HEAD --since="midnight")
echo ""
echo "┌──────────────────────────────────────────┐"
echo "│ 💡 今天第 $COMMIT_COUNT 个 commit              │"
echo "│                                          │"
echo "│ Session 结束时告诉 agent：                 │"
echo "│   「总结今天的进展，更新 STATUS 和 session」│"
echo "└──────────────────────────────────────────┘"
echo ""
